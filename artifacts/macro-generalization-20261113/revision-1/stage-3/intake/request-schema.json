{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "requests"
  ],
  "additionalProperties": false,
  "properties": {
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_ref",
          "domain",
          "intended_outcome",
          "intended_skill_plain_words",
          "request_text",
          "author_name",
          "date_written",
          "seen_before_writing",
          "paraphrase_group"
        ],
        "properties": {
          "case_ref": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "enum": [
              "arm",
              "base"
            ]
          },
          "intended_outcome": {
            "enum": [
              "inspect",
              "move",
              "missing_prerequisite",
              "partial_write",
              "unavailable_source",
              "ambiguous"
            ]
          },
          "intended_skill_plain_words": {
            "type": "string",
            "minLength": 1
          },
          "request_text": {
            "type": "string",
            "minLength": 1
          },
          "author_name": {
            "type": "string",
            "minLength": 1
          },
          "date_written": {
            "type": "string",
            "format": "date"
          },
          "paraphrase_group": {
            "type": [
              "string",
              "null"
            ]
          },
          "seen_before_writing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "project_documents",
              "dev_cases",
              "dev_results",
              "heldout_drafts",
              "stage2_transcripts",
              "none"
            ],
            "properties": {
              "project_documents": {
                "type": "boolean"
              },
              "dev_cases": {
                "type": "boolean"
              },
              "dev_results": {
                "type": "boolean"
              },
              "heldout_drafts": {
                "type": "boolean"
              },
              "stage2_transcripts": {
                "type": "boolean"
              },
              "none": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
